generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  activeStoreId String?
  accounts      Account[]
  sessions      Session[]
  stores        Store[]
  activeStore   Store?    @relation("ActiveStore", fields: [activeStoreId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum CommercePlatform {
  vtex
  nuvemshop
  shopify
  woocommerce
  custom
}

enum AiProviderKind {
  gemini
  openai
  custom
}

enum SyncJobStatus {
  pending
  running
  completed
  failed
}

enum ChatMessageRole {
  user
  assistant
  system
  tool
}

enum AnalyticsEventType {
  search
  chat_turn
  product_click
  product_view
  add_to_cart
  custom
}

model Store {
  id        String           @id @default(cuid())
  ownerId   String
  name      String
  domain    String?
  platform  CommercePlatform @default(vtex)
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  users     User[]           @relation("ActiveStore")
  credential StoreCredential?
  aiConfigs  AiProviderConfig[]
  chatSessions ChatSession[]
  catalogProducts CatalogProduct[]
  syncJobs   SyncJob[]
  searchEvents SearchEvent[]
  productClickEvents ProductClickEvent[]
  analyticsEvents AnalyticsEvent[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([ownerId])
}

model StoreCredential {
  id                String           @id @default(cuid())
  storeId           String           @unique
  platform          CommercePlatform
  encryptedPayload  String           @db.Text
  store             Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedAt         DateTime         @updatedAt
}

model AiProviderConfig {
  id              String         @id @default(cuid())
  storeId         String
  provider        AiProviderKind
  model           String
  encryptedApiKey String?        @db.Text
  baseUrl         String?
  isDefault       Boolean        @default(false)
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([storeId, provider])
  @@index([storeId])
}

model ChatSession {
  id        String        @id @default(cuid())
  storeId   String
  userId    String?
  title     String?
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([storeId, createdAt])
}

model ChatMessage {
  id          String          @id @default(cuid())
  sessionId   String
  role        ChatMessageRole
  content     String          @db.Text
  productRefs Json?
  toolCalls   Json?
  intent      String?
  latencyMs   Int?
  tokensIn    Int?
  tokensOut   Int?
  session     ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@index([sessionId, createdAt])
}

model CatalogProduct {
  id          String   @id @default(cuid())
  storeId     String
  externalId  String
  sku         String?
  name        String
  brand       String?
  category    String?
  description String?  @db.Text
  price       Decimal? @db.Decimal(12, 2)
  listPrice   Decimal? @db.Decimal(12, 2)
  available   Boolean  @default(true)
  url         String?
  imageUrl    String?
  embeddingId String?
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([storeId, externalId])
  @@index([storeId, name])
  @@index([storeId, updatedAt])
}

model SyncJob {
  id        String           @id @default(cuid())
  storeId   String
  platform  CommercePlatform
  status    SyncJobStatus    @default(pending)
  progress  Int              @default(0)
  error     String?          @db.Text
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([storeId, status])
}

model SearchEvent {
  id           String   @id @default(cuid())
  storeId      String
  sessionId    String?
  query        String
  resultCount  Int      @default(0)
  zeroResults  Boolean  @default(false)
  source       String   @default("chat")
  intent       String?
  productIds   String[] @default([])
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([storeId, createdAt])
}

model ProductClickEvent {
  id        String   @id @default(cuid())
  storeId   String
  sessionId String?
  productId String
  source    String   @default("chat")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  storeId    String
  type       AnalyticsEventType
  payload    Json
  occurredAt DateTime           @default(now())
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, type, occurredAt])
}
